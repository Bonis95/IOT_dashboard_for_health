# Copy this file to ".env" and adjust. Every line is optional.
# If the password is wrong or missing, main.py asks for it in the terminal.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=vitals_db

APP_HOST=127.0.0.1
APP_PORT=8000

# Same seed = same sample data every time. Leave empty for different data on each (re)seed.
RANDOM_SEED=42

# Upper limit of rows returned by a single query.
MAX_ROWS=50000
